# Server-only configuration. Copy to .env for local development.
# Injected environment variables take precedence. Never prefix secrets with VITE_.
PORT=3001
HOST=127.0.0.1

# Optional legacy 9-currency opening FX quotes. Default remains 30-currency historical mode.
# TWELVE_DATA_API_KEY=

# Agent: OpenAI-compatible Chat Completions API; no key means local-only operation.
# Base URL ends with /v1 (or your provider's equivalent), not /chat/completions.
# In managed cloud, configure the secret for your actual provider hostname and allow HTTPS egress.
# AGENT_API_KEY=
AGENT_BASE_URL=https://api.openai.com/v1
# AGENT_MODEL=your-model-id

# local: manually switch in the director UI after configuration.
# external: new sessions use the external director when configuration is complete.
AGENT_MODE=local
# Providers without Structured Outputs may use json_object; economic validation still applies.
AGENT_RESPONSE_FORMAT=json_schema
# Some compatible providers require max_tokens instead of max_completion_tokens.
AGENT_TOKEN_PARAMETER=max_completion_tokens
AGENT_TIMEOUT_MS=10000
AGENT_MAX_RETRIES=1
# Shared across ALL sessions, counting retries as calls.
AGENT_REQUESTS_PER_MINUTE=6
AGENT_MAX_CONCURRENT=2
