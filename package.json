{
  "name": "fx-battler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,yellow \"npm run dev -w @fx/server\" \"npm run dev -w @fx/web\"",
    "build": "npm run typecheck && npm run build -w @fx/web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "start": "npm run start -w @fx/server",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:preview": "node scripts/build-preview.mjs",
    "test:offline": "npm run build:preview && playwright test --config playwright.offline.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.15.0",
    "concurrently": "^9.1.2",
    "prettier": "^3.9.10",
    "typescript": "~5.8.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.0"
  }
}
